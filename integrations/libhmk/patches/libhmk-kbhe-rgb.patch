+  adc_initialized = true;
+  adc_buffer_invalidate();
+  if (HAL_ADC_Start_DMA(&adc_handle, (uint32_t *)adc_buffer,
+                        ADC_NUM_MUX_INPUTS + ADC_NUM_RAW_INPUTS) != HAL_OK)
+    board_error_handler();
+#endif
+}
