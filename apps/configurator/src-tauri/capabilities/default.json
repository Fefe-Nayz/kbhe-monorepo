{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "dialog:default",
    "store:default",
    "fs:default",
    "autostart:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "**/*.bin" },
        {
          "path": "$TEMP/kbhe-configurator/firmware/*/kbhe-app.bin.sig"
        },
        {
          "path": "$TEMP/kbhe-configurator/firmware/*/kbhe-app-updater-v3.bin.sig"
        }
      ]
    }
  ]
}
